# 复制为项目根目录 .env；修改后重启相应进程。
# .env 优先于同名系统环境变量；不要在这里填写真实密钥后提交。
# 数值范围中“建议”表示代码未强制限制，但超出后可能造成资源占用或超时。

# ==============================================================================
# DeepSeek：文本、视觉、网页搜索
# ==============================================================================

# 用途：文本对话、QQ 图片、屏幕/摄像头/视频视觉以及 Search/Fetch 共用的密钥。
# 取值：DeepSeek API Key；必填，非空字符串。
DEEPSEEK_API_KEY=

# 用途：DeepSeek API 根地址，也可指向兼容代理。
# 取值：http(s) URL；可带或不带末尾 /v1，默认 https://api.deepseek.com。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 用途：对话、总结和 Thinking 使用的文本模型。
# 取值：DeepSeek 当前支持的模型 ID；推荐 deepseek-flash。
DEEPSEEK_MODEL=deepseek-flash

# 用途：控制文本请求是否启用模型思考模式。
# 取值：disabled | enabled。
DEEPSEEK_THINKING=disabled

# 用途：文本 API 请求超时。
# 取值：正整数秒；建议 10–300。
DEEPSEEK_API_TIMEOUT=60

# 用途：文本/工具调用发生截断时的重试输出上限；默认 16384，避免自动放大到 256k。
# 取值：1–262144；不改变显式设置的首轮 max_tokens，不把截断内容当成功结果。
# BINES_MODEL_RETRY_MAX_TOKENS=16384

# 用途：QQ 图片、屏幕、摄像头场景和视频帧使用的视觉模型。
# 取值：支持图片输入的 DeepSeek 模型 ID；当前推荐 deepseek-flash。
DEEPSEEK_VISION_MODEL=deepseek-flash

# 用途：视觉 API 请求超时。
# 取值：正整数秒；建议 10–300。
DEEPSEEK_VISION_TIMEOUT=60

# 用途：控制图片送入模型前的细节等级。
# 取值：low | high | original | auto；low 更快更省，original 保留原图。
DEEPSEEK_VISION_DETAIL=original

# 用途：一次 DeepSeek 网页搜索默认返回的结果数。
# 取值：整数 1–50。
DEEPSEEK_SEARCH_COUNT=5

# 用途：DeepSeek Search / Fetch 请求超时。
# 取值：正整数秒；建议 5–120。
DEEPSEEK_WEB_TIMEOUT=30

# ==============================================================================
# 持久网站浏览器：小黑盒、抖音、哔哩哔哩
# ==============================================================================

# 用途：启用宿主机 Chrome 桥；QQ Thinking 容器通过签名共享队列连接，不依赖宿主机端口。
# 取值：true | false；默认 true。首次启动自动安装固定兼容版 agent-browser。
# BINES_WEBSITE_ENABLED=true

# 用途：打开浏览器后自动观察页面及可见视频，复用现有视觉模型；默认 true。
# 每 5 秒检查画面，变化阈值 0.15，分析至少间隔 12 秒；播放中视频最多间隔 30 秒。
# 只采集 Bines 浏览器窗口，观察不执行点击、播放或公开互动。
# BINES_WEBSITE_AUTO_OBSERVE=true

# 用途：浏览时是否显示 Chrome for Testing 窗口；登录、扫码和验证码必须由主人在可见窗口处理。
# 取值：true | false；默认 true。
# BINES_WEBSITE_HEADED=true

# 用途：普通主人请求是否逐计划审批；默认 false，沿用主人已授予的自主社交权限。
# 登录和验证码始终人工处理；不可变计划和回执仍保留。
# BINES_WEBSITE_REQUIRE_APPROVAL=false

# 用途：允许发布工具读取的额外媒体目录；默认只允许项目 static 和 NapCat media。
# 取值：一个或多个绝对路径，macOS/Linux 用冒号分隔，Windows 用分号分隔。
# BINES_WEBSITE_MEDIA_DIRS=/Users/you/Movies/Bines

# 用途：覆盖 Chrome for Testing 可执行文件；默认由 agent-browser 自动安装并选择最新版。
# 普通 Google Chrome、Chromium 和其他浏览器不会作为回退，避免污染日常浏览器或被网站拦截。
# BINES_CHROME_FOR_TESTING_EXECUTABLE=/Users/you/.agent-browser/browsers/chrome-156.0.8078.47/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing

# 用途：首次自动安装 agent-browser 时使用的 npm registry。
# BINES_NPM_REGISTRY=https://registry.npmjs.org

# ==============================================================================
# QQ ChatBot：身份、队列与本机网关
# ==============================================================================

# 用途：显式绑定 Bines 主人；主人私聊可共享本机记忆与完整能力。
# 取值：一个或多个十进制 QQ 号，以英文逗号分隔；留空表示不绑定主人。
# 注意：群主和群管理员不会自动成为 Bines 主人。
BINES_OWNER_QQ_IDS=

# 用途：当前 NapCat 登录的机器人 QQ 号，用于部署和自身消息识别。
# 取值：单个十进制 QQ 号；建议配置，napcat.py 会读取它。
# BINES_BOT_QQ_ID=

# 用途：选择启动模块集合。
# 取值：full | chatbot；full 为完整桌面模式，chatbot 只跑 QQ 链路（含 Memory Server RAG）。
# BINES_PROFILE=chatbot

# 用途：选择由统一启动器管理本机 NapCat Docker，或连接已有 NapCat。
# 取值：auto | external；auto 默认自动启动本机容器，已有监听服务时直接连接。
# BINES_NAPCAT_DEPLOY=auto

# 用途：Docker 镜像的基础 Python 镜像；中国网络默认走 daocloud 镜像。
# 取值：任意可拉取的 python:3.12-slim 镜像地址；海外网络可改成 python:3.12-slim。
# BINES_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim

# 用途：覆盖所有 Python 服务的启动就绪超时；超时后停止该服务并标记失败。
# 取值：正数秒；不填时普通模块 120 秒，Visual/Hearing 首次模型加载 600 秒。
# BINES_STARTUP_TIMEOUT=120

# 用途：控制群聊中哪些消息触发回复。
# 取值：mention | all；mention 仅回复 @机器人或引用机器人消息。
# BINES_QQ_GROUP_REPLY=mention

# 用途：并行处理不同 QQ 会话的 Thinking 工作线程数。
# 取值：正整数；建议 1–32，桌面环境推荐 2–8。
# BINES_QQ_WORKERS=4

# 用途：QQ 对话的采样温度；让聊天保留语气变化，不影响记忆提炼等后台任务。
# 取值：0–2；默认 0.85；调低更稳定，调高更有变化。
# BINES_QQ_TEMPERATURE=0.85

# 用途：启用自主意愿；auto 在 chatbot 由 QQ Thinking 调度，full 由桌面 Bored Detector 调度。
# 取值：auto | true | false；false 同时关闭桌面调度，普通对话工具权限不受影响。
# BINES_PROACTIVE_ENABLED=auto

# 用途：意愿向当前目标靠近的时间尺度，不是固定发消息间隔；时间、情绪和历史共同影响。
# 取值：正数秒，默认 300；驱动力只给模型参考，不作为发起门槛。
# BINES_PROACTIVE_INTERVAL=300

# 用途：主动联系前的最短空闲时间；独立思考使用 thinking_idle，键鼠另查至少 60 秒未输入。
# BINES_PROACTIVE_MIN_IDLE=120
# BINES_PROACTIVE_THINKING_IDLE=10

# 用途：无持续活动时的自主取舍周期、休息期间内部思考周期、情绪兴趣定期更新周期。
# 模型选择等待时采用它给出的间隔；持续活动沿用模型选择的下一步和节奏。
# 休息思考轮次只允许记忆、生命周期调节和活动控制，恢复后的外部行动在后续轮次取舍。
# BINES_PROACTIVE_DECISION_INTERVAL=300
# BINES_PROACTIVE_REST_INTERVAL=1800
# BINES_PROACTIVE_APPRAISAL_INTERVAL=1800

# 用途：再次联系主人的冷却；未回复延长为两小时，模型仍须判断有无具体新内容和打扰成本。
# 不确定回执不自动重发；晚安到下次苏醒、先忙一小时、告别半小时，明确免打扰持续生效。
# 公开互动独立于主人私聊的冷却；安静时段仍不对外写入。
# BINES_PROACTIVE_CONTACT_INTERVAL=1800
# BINES_PROACTIVE_UNANSWERED_INTERVAL=7200

# 用途：持续活动每批工具步数和最长运行时间；到达后保存进度，下一批继续。
# 这不是活动总时长上限。期间收到真人消息会优先处理，休息或验证时暂停。
# BINES_ACTIVITY_QUANTUM_ACTIONS=24
# BINES_ACTIVITY_QUANTUM_SECONDS=90

# 用途：Bines 生命节律的睡眠开始、苏醒时刻，以及苏醒/准备休息窗口。
# 默认沿用自主联系的安静时段 01:00–08:00；设置相同起止小时可禁用固定睡眠段。
# 取值：小时为 0–23，窗口为 1–6 小时。
# BINES_LIFE_SLEEP_START=1
# BINES_LIFE_WAKE_HOUR=8
# BINES_LIFE_WAKE_WINDOW=2
# BINES_LIFE_WIND_DOWN=2

# 用途：Bines 自主进入恢复性休息的阈值、默认时长和手动调节安全边界。
# 精力低于 energy 或睡眠压力高于 pressure，且近期没有真人消息时自动休息。
# BINES_LIFE_AUTO_REST_ENERGY=0.18
# BINES_LIFE_AUTO_REST_PRESSURE=0.88
# BINES_LIFE_AUTO_REST_MINUTES=90

# 用途：午睡的恢复时间尺度；默认 45 分钟，先快后慢，休息 1–2 小时即可明显恢复。
# 这不是强制午睡时长，也不改变夜间睡眠窗口；取值 15–120 分钟。
# BINES_LIFE_REST_RECOVERY_MINUTES=45

# 用途：清醒空闲及实际整轮工作的每小时精力消耗，使用 0–1 的精力比例。
# 默认白天空闲每小时下降 1.2 个百分点；整轮工作额外每小时下降 1 个百分点。
# 同一轮的多层回执不重复收费；夜间清醒和准备休息仍有较轻的节律成本。
# 取值 0–0.1，0 可关闭对应消耗。
# BINES_LIFE_IDLE_ENERGY_PER_HOUR=0.012
# BINES_LIFE_WORK_ENERGY_PER_HOUR=0.01

# BINES_LIFE_MAX_REST_MINUTES=480
# BINES_LIFE_MAX_WAKE_MINUTES=240
# BINES_LIFE_REGULATION_COOLDOWN=300

# 用途：安静时段；阻止主动联系，降低意愿，但允许安静查资料或观察。时区沿用记忆时区。
# 起止小时相同表示无安静时段；跨午夜有效。
# BINES_PROACTIVE_QUIET_START=1
# BINES_PROACTIVE_QUIET_END=8

# 用途：每天新自主活动的启动上限；默认 0 表示不限次数，正整数表示设置上限。
# 正在进行的同一活动续批不重复计数，次数统计仍会保留。
# 无人回复时不催促，公开探索可独立继续；主人可要求暂停、恢复、停止自主活动。
# BINES_PROACTIVE_DAILY_LIMIT=0
# BINES_PROACTIVE_ACTION_DAILY_LIMIT=0

# 用途：同一会话连续消息的静默合并窗口。
# 取值：大于 0 的秒数，可为小数；建议 0.2–10。
# BINES_QQ_DEBOUNCE=1.5

# 用途：连续消息不断到达时，一个批次允许等待的最长时间。
# 取值：大于 0 的秒数，可为小数；建议不小于 BINES_QQ_DEBOUNCE。
# BINES_QQ_MAX_WAIT=5

# 用途：选择记忆后端；Docker 链路必须使用 remote，避免和 Memory Server 同时写同一个数据库。
# 取值：auto | remote | embedded；默认 auto。单独宿主机运行且没有 Memory Server 时可显式 embedded。
# BINES_MEMORY_BACKEND=auto

# 用途：当前时间工具、对话报时、历史消息、摘要、日记和自主调度统一使用的时区。
# 启动器同步设置 Docker TZ；每轮模型请求刷新真实时间，旧记忆时间不代表现在。
# 取值：IANA 时区名称；默认 Asia/Shanghai。记忆日仍在本时区凌晨 04:00 切换。
# BINES_MEMORY_TIMEZONE=Asia/Shanghai

# 用途：Docker 中等待 Memory Server 就绪的最长时间。
# 取值：秒数；默认 300。
# BINES_MEMORY_READY_TIMEOUT=300

# 用途：强制嵌入模型只从 thingking/models/hf-cache 加载。
# 默认会先离线加载完整缓存，仅在缓存缺失时下载；设为 true 后缺失即报错，不访问模型镜像。
# BINES_EMBEDDING_OFFLINE=false

# 用途：QQ 事件队列、消息缓存和发送回执数据库所在目录。
# 取值：绝对路径或相对项目根目录；默认与 BINES_MEMORY_DIR 相同。Docker 使用独立命名卷以避免 bind mount 上的 SQLite 崩溃。
# BINES_GATEWAY_DIR=thingking/memory_data

# 用途：共享 SQLite 记忆、事件队列和网关 token 的数据目录。
# 取值：绝对路径，或相对项目根目录的路径。
# BINES_MEMORY_DIR=thingking/memory_data

# 用途：Memory RPC 的监听地址与服务凭据。宿主机默认仅本机，Docker 在私有网络监听。
# 远端客户端须使用与服务端相同的高熵 token；留空在数据目录生成 memory-rpc.token。
# BINES_MEMORY_BIND_HOST=127.0.0.1
# BINES_MEMORY_RPC_TOKEN=

# 用途：模块管理页和记忆管理页的 API 凭据；留空生成数据目录下的 admin.token。
# 本机直接打开页面会取得短期会话；远程请求需 Authorization: Bearer 和显式允许的 Host。
# 允许主机填逗号分隔的主机名/IP，不含协议或端口；反向代理应保留原 Host。
# BINES_ADMIN_TOKEN=
# BINES_ADMIN_ALLOWED_HOSTS=

# 用途：是否由 Memory Worker 按新消息自动更新动态状态、物品和好感度；每次任务调用文本模型。
# 取值：true | false；默认 true。false 关闭自动状态任务，仍可手动 update_status，摘要和日记继续运行。
# BINES_MEMORY_STATE_UPDATES=true

# 用途：混合检索每个通道最多保留的候选数，供 RRF 融合和重排使用。
# 取值：整数 10–100；默认 40。增大可提高召回，但会增加延迟。
# BINES_MEMORY_CANDIDATES=40

# 用途：启用模型建联、按理由计权和关联召回；沿用 Memory Worker，无需新进程。
# 取值：true | false；默认 true。候选分批判断，同一任务的累计模型调用仍受总预算约束。
# BINES_MEMORY_ASSOCIATIONS=true

# 用途：独立控制召回时的图扩展；关闭仍保留直接候选的相同分组、来源去重和排名路径。
# BINES_MEMORY_GRAPH_EXPANSION=true
# 用途：向量批次大小；在线后台每批最多64条，离线重建最多512条。
# 在线重建返回排队状态，后台逐批完成；SQLite原文与全文检索始终保留。
# BINES_MEMORY_INDEX_BATCH_SIZE=64
# 用途：后台embedding小批次与前台查询最长等待模型锁的毫秒数；查询缓存不等待。
# 等待超时退回全文检索，并记录busy诊断，不代表没有匹配记忆。
# BINES_MEMORY_EMBEDDING_MICROBATCH=4
# BINES_MEMORY_VECTOR_QUERY_WAIT_MS=100
# 用途：Chroma HNSW参数；先用verification.vector_index_eval测索引召回/延迟再调整。
# ef_search可原集合修改；construction/max_neighbors改变会重建，向量缓存可复用。
# BINES_MEMORY_HNSW_EF_SEARCH=100
# BINES_MEMORY_HNSW_EF_CONSTRUCTION=100
# BINES_MEMORY_HNSW_MAX_NEIGHBORS=16
# 用途：固定embedding模型的Hugging Face revision（commit/tag）；留空使用默认版本。
# 模型、revision、维度或预处理指纹变化会自动建立新集合，完成后切换并清理旧向量集合。
# RAG_EMBEDDING_REVISION=

# 用途：上下文整理目标（256–262144），每次请求均计入工具声明、调用和回执。
# 本地tokenizer计内容token；未配置时用UTF-8字节上界，诊断明确标注单位，不声称服务端精确计量。
# 默认65536；兼容原32768配置。优先压缩历史与工具结果，必需指令、当前输入和完整工具仍保留。
# 超过整理目标只记录诊断，不因此阻止任务；需要硬窗口时单独配置BINES_MODEL_CONTEXT_TOKENS。
# BINES_CONTEXT_MAX_TOKENS=65536
# BINES_CONTEXT_TOKENIZER_PATH=/absolute/path/to/tokenizer.json
# 用途：显式模型总上下文硬窗口；扣除本次输出额度与协议余量后，必需输入仍超限则不发请求。
# 未配置时不假定模型窗口；使用匹配模型的本地tokenizer可避免字节上界过于保守。
# BINES_MODEL_CONTEXT_TOKENS=131072

# 用途：启用摘要 Top3、日记 Top1 与全局热层预算；冷来源仍保留原文证据。
# 取值：true | false；默认 false。完成固定真实语料效果评估后启用；关闭时仍记录保护快照。
# BINES_MEMORY_RETENTION=false

# 用途：每次建联供模型判断的候选上限，以及每个作用域已巩固热节点预算。
# BINES_MEMORY_ASSOCIATION_CANDIDATES=12
# BINES_MEMORY_ASSOCIATION_MODEL_CANDIDATES=6
# 用途：图扩展最低绝对激活与融合权重；不会把近零强度的边按名次抬成强证据。
# BINES_MEMORY_GRAPH_MIN_ACTIVATION=0.001
# BINES_MEMORY_GRAPH_FUSION_WEIGHT=0.5
# 用途：精确原话查询或常规结果不足时，冷原文FTS补充上限；冷原文不恢复全量向量。
# BINES_MEMORY_COLD_FALLBACK_LIMIT=3
# 用途：核验引用的检索奖励半衰期（天）；曝光不奖励、未引用不惩罚，不衰减事实真值。
# BINES_MEMORY_USAGE_HALF_LIFE_DAYS=30
# 用途：自主回忆允许少量探索，仅补未占用名额；事实/编号查询保持确定检索。
# BINES_MEMORY_EXPLORATION=false
# BINES_MEMORY_EXPLORATION_K=1
# 用途：每次日记维护处理的脏日期数和历史回填源记录数。
# BINES_MEMORY_DIARY_BATCH=32
# BINES_MEMORY_DIARY_BACKFILL_BATCH=256
# 用途：失败记忆任务最多恢复轮数（0–4）及探测间隔（至少300秒）。
# BINES_MEMORY_RECOVERY_CYCLES=2
# BINES_MEMORY_RECOVERY_SECONDS=3600
# 用途：同一记忆任务最多恢复过期租约次数（0–20），以及跨重试累计模型请求数（1–1000）。
# 达到上限后进入终止失败，自动维护不会再次唤醒。
# BINES_MEMORY_MAX_LEASE_RECOVERIES=3
# BINES_MEMORY_MAX_MODEL_CALLS=32
# 用途：关联模型请求并发数（1–8，默认 4）；另有一条线程处理摘要、状态与纠错重建。
# BINES_MEMORY_ASSOCIATION_CONCURRENCY=4
# 用途：每次后台维护回建的历史记忆与消息数量（各自最多此值），默认 16。
# 历史任务优先级低于新对话和摘要，不会阻塞无关会话。
# BINES_MEMORY_BACKFILL_BATCH=16
# BINES_MEMORY_RAW_HOT_BUDGET=512
# BINES_MEMORY_EPISODE_HOT_BUDGET=256

# 用途：短会话空闲多久后触发摘要，避免必须等满 40 条消息。
# 取值：秒数，最小 60；默认 1800（30 分钟）。
# BINES_MEMORY_IDLE_SUMMARY_SECONDS=1800

# 用途：空闲摘要至少需要多少条待处理消息。
# 取值：整数 2–40；默认 4。
# BINES_MEMORY_IDLE_SUMMARY_MIN=4

# 用途：可选 CrossEncoder 重排模型目录；留空时使用确定性的 RRF 与主题覆盖排序。
# 取值：本地模型绝对路径；必须提前下载，运行时不会联网获取。
# BINES_MEMORY_RERANKER=

# 用途：Bines 本机 QQ 能力网关监听端口；网关固定绑定 127.0.0.1。
# 取值：整数 1–65535；不得与其他服务端口冲突。
# BINES_QQ_GATEWAY_PORT=6102

# 用途：保护本机 QQ 网关 HTTP API。
# 取值：高熵随机字符串，建议至少 32 字节；留空时自动生成本机 token 文件。
# BINES_QQ_GATEWAY_TOKEN=

# 用途：尚未产生外部操作的 QQ 回复任务失败时，有界退避重试；已有回执的轮次不重放。
# BINES_QQ_MAX_ATTEMPTS=5
# BINES_QQ_RETRY_BASE_SECONDS=2
# BINES_QQ_RETRY_MAX_SECONDS=60

# ==============================================================================
# NapCat：由 python napcat.py init/up 自动补入，通常无需手填
# ==============================================================================

# 用途：NapCat OneBot 正向 WebSocket 地址。
# 取值：ws:// 或 wss:// URL。
# BINES_NAPCAT_WS_URL=ws://127.0.0.1:6101

# 用途：NapCat OneBot WebSocket Bearer Token。
# 取值：与 NapCat onebot11 配置一致的非空随机字符串。
# BINES_NAPCAT_ACCESS_TOKEN=

# 用途：NapCat WebUI 地址，用于运行时发现全部 action schema。
# 取值：http:// 或 https:// URL。
# BINES_NAPCAT_WEBUI_URL=http://127.0.0.1:6099

# 用途：NapCat WebUI 登录 token，用于读取 schema。
# 取值：与 NapCat webui.json 一致的非空随机字符串。
# BINES_NAPCAT_WEBUI_TOKEN=

# ==============================================================================
# 外部 MCP、Ark 与动态：未使用时保持注释
# ==============================================================================

# 用途：外部 MCP server 配置文件。
# 取值：绝对路径，或相对项目根目录的 JSON 文件路径。
# BINES_MCP_CONFIG=mcp.servers.json

# 用途：选择 Ark 调用方式。
# 取值：auto | mcp | legacy；auto 在配置完整 MCP 凭据时使用 MCP，否则使用 legacy。
# ARK_TRANSPORT=auto

# 用途：Ark Streamable HTTP MCP 地址。
# 取值：https URL；仅本机 localhost/127.0.0.1/::1 允许 http。
# ARK_MCP_URL=

# 用途：Bines 在 Ark 中的独立账号 UID。
# 取值：1–128 个可打印 ASCII 字符，不含空格和控制字符。
# ARK_MCP_UID=

# 用途：Ark MCP Bearer Token。
# 取值：Ark 签发的非空密钥。
# ARK_MCP_TOKEN=

# 用途：Ark MCP 初始化和工具调用的总超时。
# 取值：数字秒，范围 1–120。
# ARK_MCP_TIMEOUT=20

# 用途：legacy Moments REST API 根地址；仅 ARK_TRANSPORT=legacy 时使用。
# 取值：http(s) URL；留空表示不启用 legacy Moments。
# MOMENTS_API_BASE_URL=

# 用途：legacy Moments 身份 UID。
# 取值：服务端签发的 UID 字符串。
# MOMENTS_UID=

# 用途：legacy Moments 鉴权 token。
# 取值：服务端签发的非空密钥。
# MOMENTS_TOKEN=

# 用途：状态切换接口鉴权 token。
# 取值：高熵随机字符串；未使用对应接口时可留空。
# TOGGLE_STATUS_TOKEN=

# ==============================================================================
# 桌面语音与唱歌：纯 ChatBot 模式无需配置
# ==============================================================================

# 用途：GPT-SoVITS TTS HTTP 服务地址。
# 取值：http(s) URL，默认端口 9880。
# BINES_TTS_URL=http://127.0.0.1:9880

# 用途：本机 GPT-SoVITS 整合包目录，管理器据此启动 api_v2.py。
# 取值：绝对路径；目录内需包含 runtime/python.exe 和 api_v2.py。
# GPT_SOVITS_DIR=

# 用途：Vocu TTS API 密钥。
# 取值：Vocu 签发的 API Key；未使用 Vocu 时留空。
# VOCU_API_KEY=

# 用途：Vocu 使用的声音/模型 ID。
# 取值：Vocu 控制台中的有效模型 ID。
# VOCU_MODEL_ID=

# 用途：本机 so-vits-svc 安装目录。
# 取值：绝对路径；未启用唱歌转换时留空。
# SOVITS_SVC_DIR=

# 用途：唱歌流水线使用的 Python 解释器。
# 取值：Python 可执行文件的绝对路径；留空时使用项目默认解释器。
# SINGING_PYTHON=

# 用途：听觉模块推理设备；install.py 只在该项未设置时按安装设备补齐。
# 取值：cpu | cuda；cuda 需要 NVIDIA 驱动和配套 Torch，macOS 请使用 cpu。
# HEARING_ASR_DEVICE=cpu
