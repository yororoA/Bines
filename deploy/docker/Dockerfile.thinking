ARG BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
FROM ${BASE_IMAGE}

ARG BINES_UID=1000
ARG BINES_GID=1000
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

COPY deploy/docker/install_apt.py /usr/local/bin/bines-install-apt.py
RUN python /usr/local/bin/bines-install-apt.py --mirror "${APT_MIRROR}" \
        ca-certificates \
        tzdata \
        libglib2.0-0 \
        libgomp1 \
        libsndfile1 \
        ffmpeg

WORKDIR /app

COPY requirements/ /app/requirements/
COPY requirements-chatbot.txt /app/requirements-chatbot.txt

RUN pip install --no-cache-dir \
    -r requirements/thinking.txt \
    -c requirements/ml-constraints.txt

RUN (getent group "${BINES_GID}" >/dev/null || groupadd --gid "${BINES_GID}" bines) \
    && useradd -o --uid "${BINES_UID}" --gid "${BINES_GID}" --create-home --shell /usr/sbin/nologin bines \
    && chown -R "${BINES_UID}:${BINES_GID}" /app

COPY --chown=${BINES_UID}:${BINES_GID} . /app

ARG BINES_SOURCE_HASH
LABEL io.bines.source-hash="${BINES_SOURCE_HASH}"

USER bines

CMD ["python", "thingking/rag_server.py"]
