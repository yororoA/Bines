ARG BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
ARG NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
FROM ${NODE_IMAGE} AS see-now-node
FROM ${BASE_IMAGE}

COPY --from=see-now-node /usr/local/bin/node /usr/local/bin/node

ARG BINES_UID=1000
ARG BINES_GID=1000
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY deploy/docker/install_apt.py /usr/local/bin/bines-install-apt.py
RUN python /usr/local/bin/bines-install-apt.py --mirror "${APT_MIRROR}" ca-certificates tzdata libstdc++6

WORKDIR /app

COPY requirements/ /app/requirements/
COPY requirements-chatbot.txt /app/requirements-chatbot.txt

RUN pip install --no-cache-dir -r requirements/launcher.txt

RUN (getent group "${BINES_GID}" >/dev/null || groupadd --gid "${BINES_GID}" bines) \
    && useradd -o --uid "${BINES_UID}" --gid "${BINES_GID}" --create-home --shell /usr/sbin/nologin bines \
    && chown -R "${BINES_UID}:${BINES_GID}" /app

COPY --chown=${BINES_UID}:${BINES_GID} . /app

ARG BINES_SOURCE_HASH
LABEL io.bines.source-hash="${BINES_SOURCE_HASH}"

USER bines

CMD ["python", "chatBot/main.py"]
